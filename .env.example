# Server Port
PORT=5000

# MongoDB Connection String (Atlas URI or Local MongoDB)
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/quiz_project?retryWrites=true&w=majority
# Example for Local MongoDB: mongodb://127.0.0.1:27017/quiz_project
MONGODB_URI=mongodb://127.0.0.1:27017/quiz_project

# Special Admin Credentials (Used on the Login Page -> Admin Portal)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secret for signing Admin JWT tokens
JWT_SECRET=quiz_admin_jwt_secret_token_key_2026
